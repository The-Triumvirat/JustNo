APP_NAME=JustNo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
INITIAL_ADMIN_EMAIL=owner@justno.test
# Generate a unique random password before manually seeding (see README).
INITIAL_ADMIN_PASSWORD=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=justno
DB_USERNAME=justno
DB_PASSWORD=change-this-local-password
MARIADB_DATABASE=justno
MARIADB_USER=justno
MARIADB_PASSWORD=change-this-local-password
MARIADB_ROOT_PASSWORD=change-this-local-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=justno@example.test
MAIL_FROM_NAME=JustNo
DOCKER_HTTP_PORT=8081
